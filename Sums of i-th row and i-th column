// https://www.geeksforgeeks.org/problems/sums-of-i-th-row-and-i-th-column3054/1
class Solution {
public:
    bool sumOfRowCol(vector<vector<int>> &mat) {

        int n = mat.size();
        int m = mat[0].size();

        int limit = min(n, m);

        for (int i = 0; i < limit; i++) {

            int rowSum = 0;
            int colSum = 0;

            // Sum of ith row
            for (int j = 0; j < m; j++) {
                rowSum += mat[i][j];
            }

            // Sum of ith column
            for (int j = 0; j < n; j++) {
                colSum += mat[j][i];
            }

            if (rowSum != colSum)
                return false;
        }

        return true;
    }
};
